{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowListEKSClustersGlobal",
      "Effect": "Allow",
      "Action": [
        "eks:ListClusters"
      ],
      "Resource": "*",
      "Comment": "Permits listing all EKS cluster names across the target region."
    },
    {
      "Sid": "AllowDescribeOnlyTaggedClusters",
      "Effect": "Allow",
      "Action": [
        "eks:DescribeCluster",
        "eks:ListTagsForResource"
      ],
      "Resource": "arn:aws:eks:*:*:cluster/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/k6s": "enabled"
        }
      },
      "Comment": "Restricts EKS Describe and ListTags actions strictly to EKS clusters carrying the specific 'k6s=enabled' tag."
    }
  ]
}
