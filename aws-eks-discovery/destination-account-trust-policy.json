{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::<PORTAL_AWS_ACCOUNT_ID>:role/<PORTAL_BACKEND_ROLE_NAME>"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "sts:ExternalId": "StratosEKSDiscoveryExternalID"
        }
      }
    }
  ]
}
